{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upload-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOM",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
